# Application
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackaton_upload?schema=public

# S3 / MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=hackaton-diagrams
S3_FORCE_PATH_STYLE=true

# RabbitMQ Messaging
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Exchange and Queue Names
RABBITMQ_EXCHANGE=hackaton.events
RABBITMQ_ANALYSIS_REQUESTED_QUEUE=analysis.requested
RABBITMQ_ANALYSIS_FAILED_QUEUE=analysis.failed
RABBITMQ_REPORT_GENERATED_QUEUE=report.generated
